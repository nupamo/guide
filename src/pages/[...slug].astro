---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GuideIcon from '../components/GuideIcon';
import { guides, pagePath } from '../data/guides';
import { DEFAULT_LOCALE, LOCALES, getMessages, localePath, type Locale } from '../i18n';
import { ArrowLeft, ArrowRight, ShoppingBag } from 'lucide-react';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  const byId = new Map(entries.map(e => [e.id, e]));
  return LOCALES.flatMap(locale => guides.flatMap(guide => guide.pages.map(page => {
    const entry = byId.get(`${locale}/${guide.slug}/${page.slug}`);
    if (!entry) throw new Error(`Missing page: ${locale}/${guide.slug}/${page.slug}.md`);
    const path = pagePath(guide.slug, page.slug);
    return {
      params: { slug: `${locale === DEFAULT_LOCALE ? '' : `${locale}/`}${path}`.replace(/\/$/, '') },
      props: { locale, guide, page, entry, path },
    };
  })));
}

const { locale, guide, page, entry, path } = Astro.props as {
  locale: Locale; guide: (typeof guides)[number]; page: (typeof guides)[number]['pages'][number];
  entry: Awaited<ReturnType<typeof getCollection<'docs'>>>[number]; path: string;
};
const t = getMessages(locale as Locale);
const { Content, headings } = await render(entry);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const index = guide.pages.indexOf(page);
const prev = guide.pages[index - 1];
const next = guide.pages[index + 1];
const href = (slug: string) => localePath(locale, pagePath(guide.slug, slug));
---
<Layout title={entry.data.title} description={entry.data.description ?? guide.description[locale]} locale={locale} path={path} doc>
  <div class="doc-shell">
    <aside class="doc-nav">
      <a class="doc-guide" href={href(guide.pages[0].slug)}>
        <GuideIcon name={guide.icon} size={22} className="doc-guide-icon" />
        <span>{guide.name[locale]}</span>
      </a>
      <nav aria-label={t.pages}>
        <ol>
          {guide.pages.map(p => <li><a href={href(p.slug)} aria-current={p === page ? 'page' : undefined}>{p.title[locale]}</a></li>)}
        </ol>
      </nav>
      {guide.booth && (
        <a class="doc-chip" href={guide.booth} target="_blank" rel="noopener">
          <ShoppingBag size={13} aria-hidden="true" />{t.booth}<span class="visually-hidden">{t.newTab}</span>
        </a>
      )}
    </aside>
    <article class="doc-body">
      <div class="prose"><Content /></div>
      {(prev || next) && (
        <nav class="pager" aria-label={`${t.prev} / ${t.next}`}>
          {prev ? <a class="pager-link" href={href(prev.slug)} rel="prev"><small><ArrowLeft size={12} aria-hidden="true" />{t.prev}</small><span>{prev.title[locale]}</span></a> : <span />}
          {next && <a class="pager-link next" href={href(next.slug)} rel="next"><small>{t.next}<ArrowRight size={12} aria-hidden="true" /></small><span>{next.title[locale]}</span></a>}
        </nav>
      )}
    </article>
    {toc.length > 1 && (
      <aside class="doc-toc">
        <nav aria-labelledby="toc-heading">
          <h2 id="toc-heading">{t.onThisPage}</h2>
          <ol>{toc.map(h => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      </aside>
    )}
  </div>
</Layout>
