---
import '../styles/global.css';
import { LOCALES, LOCALE_NAMES, getMessages, localePath, type Locale } from '../i18n';
import { Languages, Moon, Sun } from 'lucide-react';
interface Props { title: string; description: string; locale: Locale; path?: string; home?: boolean; doc?: boolean; }
const { title, description, locale, path = '', home = false, doc = false } = Astro.props;
const t = getMessages(locale);
const site = Astro.site ?? Astro.url;
---
<!doctype html>
<html lang={LOCALE_NAMES[locale].lang} data-astryx-theme="neutral">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={new URL(localePath(locale, path), site).href} />
    {LOCALES.map(l => <link rel="alternate" hreflang={LOCALE_NAMES[l].lang} href={new URL(localePath(l, path), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('ko', path), site).href} />
    <script is:inline>
      // Apply a saved theme before paint. Without one, the OS setting decides.
      try { const t = localStorage.getItem('guide-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    <title>{title === 'guide' ? title : `${title} · guide`}</title>
  </head>
  <body class:list={{ 'home-page': home, 'doc-page': doc }}>
    <a href="#main" class="skip-link">{t.skip}</a>
    <header class="site-header">
      <a class="wordmark" href={localePath(locale)} aria-label={t.home}>guide<span aria-hidden="true">.</span></a>
      <div class="header-actions">
        <slot name="header-nav" />
        <label class="language-select">
          <Languages size={14} aria-hidden="true" />
          <span class="visually-hidden">{t.language}</span>
          <select data-language-select>
            {LOCALES.map(l => <option value={localePath(l, path)} lang={LOCALE_NAMES[l].lang} selected={l === locale}>{LOCALE_NAMES[l].name}</option>)}
          </select>
        </label>
        <noscript>
          <nav class="language-switch" aria-label={t.language}>
            {LOCALES.map(l => <a href={localePath(l, path)} hreflang={LOCALE_NAMES[l].lang} lang={LOCALE_NAMES[l].lang} aria-current={l === locale ? 'page' : undefined}>{LOCALE_NAMES[l].short}</a>)}
          </nav>
        </noscript>
        <button type="button" class="theme-toggle" data-theme-toggle hidden aria-label={t.darkMode} title={t.darkMode} aria-pressed="false">
          <Moon className="icon-moon" size={16} aria-hidden="true" />
          <Sun className="icon-sun" size={16} aria-hidden="true" />
        </button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <script is:inline>
      document.querySelector('[data-language-select]')?.addEventListener('change', e => { location.href = e.target.value; });
      const button = document.querySelector('[data-theme-toggle]');
      const root = document.documentElement;
      const media = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : media.matches;
      const sync = () => button.setAttribute('aria-pressed', String(isDark()));
      button.hidden = false;
      sync();
      media.addEventListener('change', sync);
      button.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('guide-theme', next); } catch {}
        sync();
      });
    </script>
  </body>
</html>
